{
  "name": "@app/api-azure",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "esbuild src/functions/generate-einvoice.ts --bundle --platform=node --target=node22 --format=esm --external:@azure/functions --external:@stafyniaksacha/facturx --external:pdf-lib --outdir=dist/functions && esbuild src/start-local-server.ts --bundle --platform=node --target=node22 --format=esm --external:@stafyniaksacha/facturx --external:pdf-lib --outdir=dist/local",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "func start",
    "dev": "tsx watch src/start-local-server.ts",
    "serve": "tsx src/start-local-server.ts"
  },
  "dependencies": {
    "@app/api-contract": "workspace:*",
    "@app/einvoice-service": "workspace:*",
    "@azure/functions": "^4.16.5",
    "@stafyniaksacha/facturx": "^0.6.1",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
